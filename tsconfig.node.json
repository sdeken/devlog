{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@devlog/core": ["packages/core/src/index.ts"],
      "@devlog/core/*": ["packages/core/src/*"],
      "@devlog/extension-api": ["packages/extension-api/src/index.ts"],
      "@devlog/extension-api/*": ["packages/extension-api/src/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "packages/core/src/**/*",
    "packages/core/tests/**/*",
    "packages/extension-api/src/**/*",
    "packages/extension-api/tests/**/*"
  ]
}
