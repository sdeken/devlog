{
  "name": "probe",
  "displayName": "Probe",
  "version": "1.0.0",
  "description": "Test extension: exercises the API and checks the sandbox.",
  "api": "^1.0.0",
  "main": "main.js",
  "contributes": {
    "canvasFields": [{ "key": "code", "label": "Probe code", "placeholder": "P-1" }],
    "settings": [{ "key": "greeting", "label": "Greeting" }],
    "secrets": [{ "key": "token", "label": "Token" }],
    "commands": [
      { "id": "probe", "label": "Probe the sandbox" },
      { "id": "hello", "label": "Say hello" }
    ]
  },
  "permissions": { "read": true, "write": true, "network": ["example.com"] },
  "appendOnly": ["log/*.jsonl"]
}
